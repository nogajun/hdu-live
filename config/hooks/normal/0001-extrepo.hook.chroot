#!/bin/sh

set -e

# extrepo setup and install packages

apt-get -y purge needrestart

sed -ie 's/^# -/-/g' /etc/extrepo/config.yaml
extrepo update


# enable ext repos
repos="debian_backports google_chrome mozilla r-project uv vscode virtualbox docker-ce"
for repo in $repos; do
  extrepo enable $repo
done

# install ext repo packages
packages="code google-chrome-stable uv ruff docker-ce"
apt-get -y -U install $packages
